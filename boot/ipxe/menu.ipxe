#!ipxe

# Generated by scripts/generate-ipxe-menu.py.
# Only ready catalog entries with kernel+initrd artifacts are included.

menu NetInstall - Select an operating system
item ubuntu-24.04 Ubuntu 24.04 LTS (network installer)
item debian-13 Debian 13 (Trixie) (network installer)
item shell iPXE shell
choose selected || goto shell

goto ${selected}

:ubuntu-24.04
echo Loading Ubuntu 24.04 LTS network installer...
kernel https://releases.ubuntu.com/24.04/netboot/amd64/linux ip=dhcp ---
initrd https://releases.ubuntu.com/24.04/netboot/amd64/initrd
boot

:debian-13
echo Loading Debian 13 (Trixie) network installer...
kernel https://deb.debian.org/debian/dists/trixie/main/installer-amd64/current/images/netboot/debian-installer/amd64/linux ip=dhcp ---
initrd https://deb.debian.org/debian/dists/trixie/main/installer-amd64/current/images/netboot/debian-installer/amd64/initrd.gz
boot

:shell
shell
