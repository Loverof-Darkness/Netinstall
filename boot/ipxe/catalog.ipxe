#!ipxe

# NetInstall remote control script.
set base https://raw.githubusercontent.com/Loverof-Darkness/Netinstall/main
set catalog ${base}/catalog/operating-systems.json

echo
 echo ========================================
echo        NetInstall Remote Catalog
echo ========================================
echo

echo Repository: Loverof-Darkness/Netinstall
echo Catalog: ${catalog}
echo

echo Downloading catalog metadata...
imgfetch ${catalog} || goto catalog-error
echo Catalog downloaded.
echo

menu NetInstall
item ubuntu         Ubuntu 24.04 LTS
item debian         Debian 13
item fedora         Fedora Workstation
item windows        Windows 11
item shell          iPXE shell
choose os || goto shell

goto ${os}

:ubuntu
echo Ubuntu selected.
echo Installer integration will be added by the deployment engine.
goto shell

:debian
echo Debian selected.
echo Installer integration will be added by the deployment engine.
goto shell

:fedora
echo Fedora selected.
echo Installer integration will be added by the deployment engine.
goto shell

:windows
echo Windows selected.
echo WinPE integration will be added by the deployment engine.
goto shell

:shell
shell

:catalog-error
echo Failed to download the catalog over HTTPS.
shell
