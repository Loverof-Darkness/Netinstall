#!ipxe

# NetInstall network boot menu.
# URLs below point only to HTTPS release artifacts from the OS vendors.

set base https://raw.githubusercontent.com/Loverof-Darkness/Netinstall/main
set catalog ${base}/catalog/operating-systems.json
set menu-url ${base}/boot/ipxe/menu.ipxe

echo
 echo ========================================
echo        NetInstall Network Installer
echo ========================================
echo

echo Fetching catalog metadata...
imgfetch ${catalog} || goto catalog-error
echo Catalog metadata available.
echo Loading boot menu...
chain --replace ${menu-url} || goto menu-error

:catalog-error
echo Failed to retrieve the NetInstall catalog.
echo Verify HTTPS connectivity.
shell

:menu-error
echo Failed to retrieve the NetInstall boot menu.
shell
